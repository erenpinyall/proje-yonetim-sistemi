# Copy this file to .env and replace the values. Never commit .env.
# docker compose reads it automatically.

POSTGRES_DB=TaskTrackerDb
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me

# Use at least 32 characters. Generate one with:
#   openssl rand -base64 48
JWT_KEY=change-me-to-a-random-32-plus-character-secret
JWT_ISSUER=TaskTracker.API
JWT_AUDIENCE=TaskTracker.Client
